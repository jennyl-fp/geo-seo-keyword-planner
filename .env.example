# 本檔案只列變數名（不含任何 secret）。複製成 .env 並自行填入。

# Ahrefs REST API v3（唯一付費源；ADR-002）
AHREFS_API_TOKEN=

# First Page agency MCP — GSC 優先路徑（ADR-010）
FIRSTPAGE_MCP_TOKEN=
# FIRSTPAGE_MCP_URL=   # 預設 https://mcp.firstpage.com.hk/mcp/

# GSC 後備路徑（service account；有 FIRSTPAGE_MCP_TOKEN 時不需）
# GOOGLE_APPLICATION_CREDENTIALS=
# GSC_SITE_URL=        # 例：https://www.example.com.hk/（不設則依報表 domain 自動匹配）

# GKP — 本地 Keyword Planner MCP server 子進程（ADR-006）
# 注意：子進程需同時有 GOOGLE_ADS_* 環境變數才能啟動（見下）
KEYWORD_PLANNER_MCP_COMMAND=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
